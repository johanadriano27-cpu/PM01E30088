<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0D4F8B"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="Nuevo contacto"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imgContacto"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_circulo"
                android:clipToOutline="true"
                android:padding="30dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                />


            <Button
                android:id="@+id/btnImagen"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Agregar imagen"
                android:textColor="#0D4F8B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="País"
                android:textColor="#000000" />

            <Spinner
                android:id="@+id/spPais"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_campo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nombre"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_campo"
                android:hint="Ej: Ana López"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#555555" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Teléfono"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/etTelefono"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_campo"
                android:hint="Ej: 98765432"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#555555" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nota"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/etNota"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_campo"
                android:hint="Ej: Compañera de clase"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#555555" />

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#0D4F8B"
                android:text="Guardar contacto"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnVer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="Ver contactos"
                android:textColor="#0D4F8B" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>